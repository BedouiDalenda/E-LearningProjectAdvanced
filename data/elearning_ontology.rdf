    <!-- http://www.elearning-platform.org/ontology#Introduction_to_Python -->

    <owl:NamedIndividual rdf:about="http://www.elearning-platform.org/ontology#Introduction_to_Python">
        <rdf:type rdf:resource="http://www.elearning-platform.org/ontology#BeginnerCourse"/>
        <ontology:helpsAchieve rdf:resource="http://www.elearning-platform.org/ontology#Change_Career_To_Tech"/>
        <ontology:suitableForLevel rdf:resource="http://www.elearning-platform.org/ontology#Beginner_Level"/>
        <ontology:teachesSkill rdf:resource="http://www.elearning-platform.org/ontology#Python_Programming"/>
        <ontology:hasDifficulty rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</ontology:hasDifficulty>
        <ontology:hasDuration rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">40</ontology:hasDuration>
        <ontology:hasPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">150.0</ontology:hasPrice>
        <ontology:hasRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.5</ontology:hasRating>
        <ontology:hasTitle>Introduction to Python Programming</ontology:hasTitle>
        <ontology:requiresMathLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</ontology:requiresMathLevel>
