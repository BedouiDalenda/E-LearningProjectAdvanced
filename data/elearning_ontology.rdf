    <!-- http://www.elearning-platform.org/ontology#ML_Without_Heavy_Math -->

    <owl:NamedIndividual rdf:about="http://www.elearning-platform.org/ontology#ML_Without_Heavy_Math">
        <rdf:type rdf:resource="http://www.elearning-platform.org/ontology#IntermediateCourse"/>
        <ontology:helpsAchieve rdf:resource="http://www.elearning-platform.org/ontology#Learn_AI"/>
        <ontology:requiresSkill rdf:resource="http://www.elearning-platform.org/ontology#Python_Programming"/>
        <ontology:suitableForLevel rdf:resource="http://www.elearning-platform.org/ontology#Intermediate_Level"/>
        <ontology:teachesSkill rdf:resource="http://www.elearning-platform.org/ontology#Machine_Learning"/>
